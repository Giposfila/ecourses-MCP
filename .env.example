# Скопируйте этот файл в .env и впишите свои данные.
#   cp .env.example .env
#   chmod 600 .env
#
# server.py и smoke.py автоматически читают .env из папки проекта.
# Переменные, заданные явно в окружении (shell или MCP-клиент), имеют приоритет.
# НЕ коммитьте .env в git.

SFU_USERNAME=ваш_логин
SFU_PASSWORD=ваш_пароль

# Необязательно: куда складывать скачанные материалы заданий.
# По умолчанию ~/Downloads/sfu-ecourses
# SFU_DOWNLOAD_DIR=~/Downloads/sfu-ecourses

# Необязательно: лимит размера одного файла в мегабайтах (по умолчанию 25)
# SFU_DOWNLOAD_MAX_MB=25
