# Скопируйте этот файл в .env и впишите свои данные.
#   cp .env.example .env
#   chmod 600 .env
#
# server.py и smoke.py автоматически читают .env из папки проекта.
# Переменные, заданные явно в окружении (shell или MCP-клиент), имеют приоритет.
# НЕ коммитьте .env в git.

SFU_USERNAME=ваш_логин
SFU_PASSWORD=ваш_пароль
